# Xcode project — generated by `xcodegen generate`, never committed (see project.yml)
Hintjump.xcodeproj/

# Swift Package Manager
.build/
.swiftpm/

# Xcode
DerivedData/
*.xcresult
xcuserdata/

# Build output
build/
*.dmg

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Claude Code
.claude/settings.local.json

# Local, machine-specific build settings — an optional Debug signing identity
# (see Config/Debug.xcconfig); the commit-time guard refuses it too
Config/Local.xcconfig

# Environment variables
.env
.env.*

# Python bytecode — written beside a skill script under .claude/skills/ or
# .agents/skills/ that imports a sibling module; scripts/sync-agents.sh skips it too
__pycache__/

# OS
.DS_Store
Thumbs.db
